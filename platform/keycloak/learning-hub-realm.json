{
  "realm": "learning-hub",
  "enabled": true,
  "displayName": "Learning Hub",
  "registrationAllowed": false,
  "resetPasswordAllowed": true,
  "rememberMe": false,
  "bruteForceProtected": true,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 28800,
  "roles": {
    "realm": [
      { "name": "candidate" },
      { "name": "interviewer" },
      { "name": "admin" }
    ]
  },
  "clients": [
    {
      "clientId": "learning-hub-web",
      "name": "Learning Hub Web",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": ["https://learning.127.0.0.1.nip.io:8443/oidc/callback", "http://localhost:3000/oidc/callback"],
      "webOrigins": ["https://learning.127.0.0.1.nip.io:8443", "http://localhost:3000"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "https://learning.127.0.0.1.nip.io:8443/signed-out##http://localhost:3000/signed-out",
        "oauth2.device.authorization.grant.enabled": "false"
      },
      "protocolMappers": [
        {
          "name": "learning-hub-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "learning-hub-api",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ]
}
